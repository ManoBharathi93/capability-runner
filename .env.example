# Model provider: openai | anthropic | gemma
LLM_PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Gemma / OpenAI-compatible endpoint
GEMMA_BASE_URL=
GEMMA_MODEL=
GEMMA_API_KEY=

# Ignored local runtime storage
CAPABILITY_RUNNER_VAR_DIR=var
# Optional administrator-attested read-only sandbox entry URLs, JSON array.
# Built-in local demo applications are already allowed. Empty means no additional origins.
CAPABILITY_RUNNER_READ_ONLY_URLS=[]

# Product intervention browser: false opens the existing managed window for humans.
# Use true only for automated tests or environments without a desktop.
CAPABILITY_RUNNER_BROWSER_HEADLESS=false
